<view class="page {{!loggedIn ? 'login-page' : ''}} {{loggedIn && tab === 'fridge' ? 'fridge-page' : ''}}" style="{{loggedIn && tab === 'fridge' ? 'height:' + visibleHeight + 'px;' : ''}}">
  <view wx:if="{{!loggedIn}}" class="login">
    <text class="headline">两人厨房</text><text class="description">一起选菜，一起评分。</text>
    <view wx:if="{{error}}" class="error">{{error}}</view>
    <view wx:if="{{!accountReady}}" class="card login-card"><view class="title">微信登录</view><button class="primary full" loading="{{busy}}" disabled="{{busy}}" bindtap="wechatLogin">微信登录</button></view>
    <block wx:else>
      <view class="row account-tools"><button class="link" bindtap="copyUserId">复制我的账号标识</button><button class="link" disabled="{{busy}}" bindtap="accountLogout">退出微信登录</button></view>
      <button wx:if="{{administrator}}" class="secondary full" disabled="{{busy}}" bindtap="scanAdminLogin">扫描登录管理网页</button>
      <view class="card"><view class="title">进入时使用的身份</view><view class="row"><button class="role {{loginRole === 0 ? 'chosen' : ''}}" data-role="0" bindtap="chooseRole">男生</button><button class="role {{loginRole === 1 ? 'chosen' : ''}}" data-role="1" bindtap="chooseRole">女生</button></view></view>
      <view class="card"><view class="dish-top"><view class="title">我的厨房</view><button class="link" disabled="{{busy}}" bindtap="refreshKitchens">刷新</button></view>
        <view wx:if="{{!kitchens.length}}" class="empty">还没有加入厨房。可以创建，或输入口令申请加入。</view>
        <view wx:for="{{kitchens}}" wx:key="id" class="kitchen-row"><view class="dish-top"><text class="title">{{item.name}}</text><button class="primary" disabled="{{busy}}" data-id="{{item.id}}" bindtap="enterKitchen">进入</button></view><text wx:if="{{item.lastVisitText}}" class="small">最近访问：{{item.lastVisitText}}</text><view wx:if="{{item.owner}}" class="row"><button class="link" disabled="{{busy}}" data-id="{{item.id}}" bindtap="showRequests">加入申请</button><button class="link" disabled="{{busy}}" data-id="{{item.id}}" bindtap="resetInvitation">生成加入口令</button></view></view>
        <view class="row"><button wx:if="{{kitchensAfter}}" class="secondary" bindtap="refreshKitchens">回到第一页</button><button wx:if="{{kitchensNext}}" class="secondary" bindtap="nextKitchens">下一页</button></view>
      </view>
      <view wx:if="{{requestKitchen}}" class="card"><view class="dish-top"><view class="title">加入申请</view><button class="link" bindtap="closeRequests">关闭</button></view><view wx:if="{{!requests.length}}" class="empty">暂无待处理申请</view><view wx:for="{{requests}}" wx:key="userId" class="kitchen-row"><text selectable class="account-id">{{item.userId}}</text><view class="row"><button class="primary" disabled="{{busy}}" data-user="{{item.userId}}" data-approved="yes" bindtap="decideRequest">同意</button><button class="secondary" disabled="{{busy}}" data-user="{{item.userId}}" data-approved="no" bindtap="decideRequest">拒绝</button></view></view><button wx:if="{{requestsNext}}" class="secondary full" bindtap="nextRequests">下一页申请</button></view>
      <view class="card"><view class="title">申请加入厨房</view><input maxlength="64" value="{{passphrase}}" bindinput="onPassphrase" placeholder="粘贴创建者分享的口令" confirm-type="go" bindconfirm="login"/><button class="secondary full" loading="{{busy}}" disabled="{{busy}}" bindtap="login">发送加入申请</button></view>
      <view class="card"><view class="title">创建新厨房</view><input maxlength="40" value="{{newKitchenName}}" bindinput="onKitchenName" placeholder="厨房名称"/><button class="primary full" loading="{{busy}}" disabled="{{busy || !newKitchenName}}" bindtap="createKitchen">创建厨房</button><text class="small">{{unlimited ? '白名单账号不受厨房数量和每日创建次数限制' : '最多创建3个厨房，每天最多创建1个'}}</text></view>
    </block>
  </view>
  <block wx:else>
    <view class="top"><text>{{kitchenName || "两人厨房"}}</text><button class="link" disabled="{{busy}}" bindtap="logout">{{roleName}} · 切换厨房 / 身份</button></view>
    <view wx:if="{{invitation}}" class="card"><view class="title">加入口令已生成</view><text class="small">分享给另一位，收到申请后在“我的厨房”中同意。</text><button class="secondary full" bindtap="copyInvitation">复制加入口令</button></view>
    <view wx:if="{{!synced}}" class="sync">正在连接厨房…</view><view wx:if="{{error}}" class="error">{{error}}</view>
    <block wx:if="{{tab === 'dinner'}}">
      <text class="headline">今晚吃什么？</text>
      <view class="meal-setup">
      <view class="meal-counts"><picker range="{{countOptions}}" value="{{meatCount}}" data-field="meatCount" disabled="{{busy}}" bindchange="onMealCount"><view class="count-choice">荤菜 <text class="count-number">{{meatCount}}</text> 道 <text class="picker-caret">⌄</text></view></picker><picker range="{{countOptions}}" value="{{vegCount}}" data-field="vegCount" disabled="{{busy}}" bindchange="onMealCount"><view class="count-choice">素菜 <text class="count-number">{{vegCount}}</text> 道 <text class="picker-caret">⌄</text></view></picker><text class="small">共 {{meatCount + vegCount}} 道</text></view>
      <view class="switch-row"><text>只用冰箱食材</text><switch color="#3c5944" checked="{{fridgeOnly}}" bindchange="setFridgeOnly" /></view>
      <button class="primary full" disabled="{{busy || !synced}}" loading="{{busy}}" bindtap="createMeal">{{meal ? '重新搭配' : '帮我们搭配'}} {{meatCount + vegCount}} 道菜</button>
      <text wx:if="{{meal}}" class="small setup-note">数量和食材限制用于下一轮</text>
      </view>
      <view class="section-title">候选菜 <text class="selection-count">已入选 {{passedCount}} / {{mealCount}}</text></view>
      <text class="small score-rule">每人0–5分，双人评完公开；合计7分入选，低于7分自动换菜。</text>
      <view wx:if="{{!meal}}" class="empty">点击“帮我们搭配”，开始选菜。</view>
      <view wx:for="{{candidates}}" wx:key="id" wx:for-item="candidate" class="card dish-card">
        <view class="dish-top"><view class="dish-heading"><view class="dish-name">{{candidate.dish.name}}</view><text class="kind">{{candidate.dish.kind === 'meat' ? '荤菜' : '素菜'}}</text></view><text class="badge {{candidate.passed ? 'passed' : ''}}">{{candidate.verdict}}</text></view>
        <text class="description ingredients-line">{{candidate.ingredientsText}}</text><view class="availability">{{candidate.availability}}</view>
        <view class="rating-label">我想吃 <text>{{candidate.ownText}}</text></view>
        <view class="scores"><button wx:for="{{scores}}" wx:key="*this" wx:for-item="score" class="score {{candidate.ownScore === score ? 'chosen' : ''}}" data-id="{{candidate.id}}" data-score="{{score}}" disabled="{{busy || candidate.complete}}" bindtap="score">{{score}}</button></view>
        <view class="rating-label small"><text>另一位：{{candidate.partnerText}}</text><text>{{candidate.totalText}}</text></view>
        <text wx:if="{{candidate.blocked}}" class="note">{{candidate.blocked}}</text>
        <view class="card-footer"><view class="row"><button class="link" disabled="{{busy}}" data-id="{{candidate.id}}" bindtap="replace">换一道</button><button class="link" disabled="{{busy}}" data-id="{{candidate.id}}" bindtap="openPick">自选</button></view></view>
      </view>
      <view wx:if="{{rejectedRows.length}}" class="card"><view class="title">本轮已淘汰的菜</view><view wx:for="{{rejectedRows}}" wx:key="id" class="history-row">{{item.name}} · 男生 {{item.boyScore}} 分，女生 {{item.girlScore}} 分 · 合计 {{item.total}} 分</view></view>
      <view class="card shopping-generate"><view class="title">入选菜缺什么？</view><button class="primary full" disabled="{{busy || !passedCount}}" bindtap="shoppingGenerate">生成采购清单</button></view>
    </block>
    <block wx:elif="{{tab === 'calendar'}}">
      <text class="headline">三餐日历</text><text class="small page-caption">已完成双人评分的选菜记录</text>
      <view class="card calendar-card">
        <view class="calendar-toolbar"><button class="secondary calendar-arrow" data-offset="-1" bindtap="changeCalendarMonth" aria-label="上个月">‹</button><text class="title">{{calendarMonth}}</text><button class="secondary calendar-arrow" data-offset="1" bindtap="changeCalendarMonth" aria-label="下个月">›</button><button class="link" bindtap="calendarToday">今天</button></view>
        <view class="calendar-grid"><text wx:for="{{weekdays}}" wx:key="*this" class="calendar-week">{{item}}</text></view>
        <view class="calendar-grid"><view wx:for="{{calendarCells}}" wx:key="key" class="calendar-cell"><button wx:if="{{item.date}}" class="calendar-day {{item.selected ? 'calendar-selected' : ''}} {{item.today ? 'calendar-today' : ''}}" data-date="{{item.date}}" bindtap="chooseCalendarDate" aria-label="{{item.date}}，{{item.count}}道已完成评分菜品"><text>{{item.label}}</text><view class="calendar-dot {{item.count ? 'calendar-has-record' : ''}}"></view></button></view></view>
      </view>
      <button wx:if="{{unknownCount}}" class="link full" data-date="unknown" bindtap="chooseCalendarDate">日期无法识别的旧记录（{{unknownCount}}道）</button>
      <view class="section-title">{{calendarDate === 'unknown' ? '日期未识别的旧记录' : calendarDate}} <text class="small">已完成双人评分</text></view>
      <view wx:if="{{calendarError}}" class="error">{{calendarError}}<button class="secondary full" bindtap="retryCalendar">重新加载日历</button></view>
      <view wx:elif="{{calendarLoading}}" class="empty">正在读取记录…</view>
      <view wx:elif="{{!calendarGroups.length}}" class="empty">当天没有完成双人评分的记录。</view>
      <block wx:else>
        <text class="small">最新轮次在前</text>
        <view wx:for="{{calendarGroups}}" wx:key="id" wx:for-item="round" class="card calendar-round">
          <view class="dish-top"><text class="title">这一轮的记录</text><text class="small">本页 {{round.dishes.length + round.rejected.length}} 道</text></view><text wx:if="{{calendarDate === 'unknown'}}" class="small">原记录日期：{{round.dateLabel}}</text>
          <view wx:for="{{round.dishes}}" wx:key="id" wx:for-item="dish" class="history-dish"><view class="dish-top"><text class="title">{{dish.name}}</text><text class="kind">{{dish.kindText}}</text></view><text class="description">{{dish.ingredientsText}}</text><view class="history-score"><text>男生：{{dish.boyText}}</text><text>女生：{{dish.girlText}}</text></view><view class="history-progress"><text class="history-passed">已入选</text><text>{{dish.total}} / 10</text></view></view>
          <text wx:if="{{!round.dishes.length}}" class="note">本页这轮只有淘汰菜。</text><button wx:if="{{round.rejected.length}}" class="secondary full" data-id="{{round.id}}" bindtap="toggleCalendarRejected">{{round.rejectedOpen ? '收起' : '查看'}}淘汰菜（本页{{round.rejected.length}}道）</button>
          <block wx:if="{{round.rejectedOpen}}"><view wx:for="{{round.rejected}}" wx:key="id" wx:for-item="dish" class="history-dish"><view class="dish-top"><text class="title">{{dish.name}}</text><text class="kind">{{dish.kindText}}</text></view><text class="description">{{dish.ingredientsText}}</text><view class="history-score"><text>男生：{{dish.boyText}}</text><text>女生：{{dish.girlText}}</text></view><text class="small">{{dish.total}} / 10 · 未入选</text></view></block>
        </view>
        <text wx:if="{{calendarNext || calendarPage > 1}}" class="small page-caption">每页最多40道，同一轮可能分在两页。</text>
        <view class="calendar-pagination"><button class="secondary" disabled="{{calendarPage === 1 || calendarLoading}}" bindtap="calendarPreviousPage">上一页</button><text>第{{calendarPage}}页</text><button class="secondary" disabled="{{!calendarNext || calendarLoading}}" bindtap="calendarNextPage">下一页</button></view>
      </block>
    </block>
    <block wx:elif="{{tab === 'fridge'}}">
      <view class="fridge-content">
      <view class="fridge-heading"><view><view class="headline">冰箱</view><text class="small">{{pantry.length}} 种食材</text></view><button class="primary" disabled="{{busy || !synced}}" bindtap="openPantryAdd">添加食材</button></view>
      <view class="fridge-search"><input bindkeyboardheightchange="onKeyboardChange" value="{{pantrySearch}}" bindinput="onPantrySearch" placeholder="搜索冰箱里的食材" /><button class="secondary" disabled="{{busy || !pantry.length}}" bindtap="togglePantryManage">{{pantryManaging ? '完成' : '管理'}}</button></view>
      <text class="note fridge-note">{{pantryManaging ? '已选食材可移除或改分类，每次最多20种。' : '左滑移除食材'}}</text>
      <view class="ingredient-browser fridge-browser">
        <scroll-view scroll-y class="category-sidebar" enhanced show-scrollbar="{{false}}"><button wx:for="{{stockCategories}}" wx:key="id" class="category-button {{pantryCategory === item.id ? 'active-category' : ''}}" data-category="{{item.id}}" bindtap="selectPantryCategory"><text>{{item.label}}</text><text class="category-count">{{item.count}}</text></button></scroll-view>
        <scroll-view scroll-y class="ingredient-results" enhanced show-scrollbar="{{false}}">
          <view wx:if="{{!pantryRows.length}}" class="ingredient-empty">{{!pantry.length ? '冰箱还没有食材，点击上方添加。' : pantrySearch ? '没有匹配的食材，换个搜索词或分类。' : '这个分类还没有食材。'}}</view>
          <view wx:for="{{pantryRows}}" wx:key="name" class="pantry-swipe-row" data-name="{{item.name}}" bindtouchstart="onPantryTouchStart" bindtouchmove="onPantryTouchMove" bindtouchend="onPantryTouchEnd" bindtouchcancel="onPantryTouchCancel"><button wx:if="{{!pantryManaging && pantrySwipeName === item.name}}" class="swipe-remove" data-name="{{item.name}}" disabled="{{busy}}" catchtap="removeSwipedIngredient">移除</button><button class="ingredient-item pantry-swipe-front {{item.selected ? 'chosen' : ''}} {{pantrySwipeName === item.name ? 'swipe-open' : ''}}" data-name="{{item.name}}" disabled="{{busy}}" bindtap="togglePantryItem"><text class="ingredient-name">{{item.name}}</text><text wx:if="{{pantryManaging}}" class="ingredient-check">{{item.selected ? '已选' : '选择'}}</text></button></view>
        </scroll-view>
      </view>
      <view wx:if="{{pantryManaging && !keyboardHeight && !pantryOpen}}" class="fridge-manage-bar"><text class="small">已选 {{pantrySelected.length}} 种</text><view class="row"><picker range="{{customCategories}}" range-key="label" value="{{classifyIndex}}" disabled="{{busy || !pantrySelected.length}}" bindchange="changePantryCategory"><view class="secondary manage-category {{!pantrySelected.length ? 'muted-control' : ''}}">修改分类</view></picker><button class="primary" disabled="{{busy || !pantrySelected.length}}" bindtap="removePantrySelected">移除所选</button></view></view>
      </view>
    </block>
    <block wx:elif="{{tab === 'shopping'}}">
      <view class="headline">采购清单</view>
      <view class="add-bar"><input bindkeyboardheightchange="onKeyboardChange" value="{{ingredient}}" maxlength="40" bindinput="onIngredient" placeholder="添加还想买的食材" bindconfirm="addIngredient"/><button class="primary" disabled="{{busy || !synced}}" bindtap="addIngredient">添加</button></view>
      <view class="section-title">要买的食材 <text class="small">已买 {{boughtCount}} / {{shopping.length}}</text></view>
      <view wx:if="{{!shopping.length}}" class="empty">还没有要买的食材，可手动添加或从入选菜生成。</view>
      <view wx:for="{{shopping}}" wx:key="name" class="shopping-row"><view class="row"><switch color="#3c5944" checked="{{item.checked}}" disabled="{{busy}}" data-name="{{item.name}}" bindchange="checkShopping"/><text class="{{item.checked ? 'strike' : ''}}">{{item.name}}</text></view><button class="link" disabled="{{busy}}" data-name="{{item.name}}" bindtap="removeIngredient">移除</button></view>
      <button class="primary full" disabled="{{busy || !boughtCount}}" bindtap="toPantry">加入冰箱（{{boughtCount}}种）</button><text class="note">已买食材加入冰箱后，会从清单移除。</text>
    </block>
    <block wx:elif="{{tab === 'menu'}}">
      <view class="headline">日常菜单</view>
      <view class="add-bar"><input bindkeyboardheightchange="onKeyboardChange" value="{{search}}" bindinput="onSearch" placeholder="搜索菜名或食材"/><button class="primary" disabled="{{busy || !synced}}" bindtap="openEditor">新增</button></view>
      <view class="filters"><button wx:for="{{filters}}" wx:key="id" class="chip {{filter === item.id ? 'chosen' : ''}}" data-filter="{{item.id}}" bindtap="selectFilter">{{item.label}}</button></view>
      <view wx:if="{{!visibleDishes.length}}" class="empty">没有符合条件的菜，换个搜索词或添加新菜。</view>
      <view wx:for="{{visibleDishes}}" wx:key="id" class="card menu-card"><view class="dish-top"><text class="title">{{item.name}}</text><text class="kind">{{item.kindText}}</text></view><text class="description">{{item.ingredientsText}}</text><text class="availability">{{item.availability}}</text><view class="row menu-actions"><button class="link" disabled="{{busy}}" data-id="{{item.id}}" bindtap="openEditor">编辑</button><button class="link" disabled="{{busy}}" data-id="{{item.id}}" bindtap="toggleDish">{{item.active ? '不再推荐' : '恢复推荐'}}</button><button class="link danger" disabled="{{busy}}" data-id="{{item.id}}" data-name="{{item.name}}" bindtap="deleteDish">永久删除</button></view></view>
    </block>
    <view wx:if="{{!keyboardHeight && !editorOpen && !pickOpen && !pantryOpen && !pantryManaging}}" class="bottom-nav"><button wx:for="{{tabs}}" wx:key="id" class="nav-button {{tab === item.id ? 'selected' : ''}}" data-tab="{{item.id}}" bindtap="selectTab">{{item.label}}</button></view>
  </block>
  <view wx:if="{{pantryOpen}}" class="overlay" style="bottom:{{sheetBottom}}px;">
    <view class="sheet-mask" catchtap="closePantryAdd" catchtouchmove="swallowTap"/>
    <view class="modal pantry-sheet {{keyboardHeight ? 'keyboard-sheet' : ''}}" style="height:{{sheetHeight}}px;" catchtap="swallowTap">
      <view class="modal-title"><text>添加冰箱食材</text><button class="link" disabled="{{busy}}" bindtap="closePantryAdd">关闭</button></view>
      <view wx:if="{{!keyboardHeight || pantryFocus === 'search'}}" class="sheet-search"><input data-field="search" bindfocus="onPantryFocus" bindkeyboardheightchange="onKeyboardChange" value="{{addSearch}}" bindinput="onAddSearch" placeholder="搜索食材，如西红柿" adjust-position="{{false}}" /></view>
      <view class="ingredient-browser add-browser">
        <scroll-view scroll-y class="category-sidebar" enhanced show-scrollbar="{{false}}"><button wx:for="{{choiceCategories}}" wx:key="id" class="category-button {{addCategory === item.id ? 'active-category' : ''}}" data-category="{{item.id}}" bindtap="selectAddCategory"><text>{{item.label}}</text><text class="category-count">{{item.count}}</text></button></scroll-view>
        <scroll-view scroll-y class="ingredient-results" enhanced show-scrollbar="{{false}}"><view wx:if="{{!addChoices.length}}" class="ingredient-empty">没有找到？在下方填写自定义食材。</view><button wx:for="{{addChoices}}" wx:key="name" class="ingredient-item {{item.selected ? 'chosen' : ''}}" data-name="{{item.name}}" disabled="{{busy}}" bindtap="toggleAddItem"><text class="ingredient-name">{{item.name}}</text><text class="ingredient-check">{{item.selected ? '已选' : '选择'}}</text></button></scroll-view>
      </view>
      <view class="sheet-footer pantry-add-footer">
        <view wx:if="{{!keyboardHeight}}" class="custom-title"><text class="small">自定义食材</text><picker range="{{customCategories}}" range-key="label" value="{{customCategoryIndex}}" disabled="{{busy}}" bindchange="onCustomCategory"><view class="custom-category">{{customCategories[customCategoryIndex].label}} ⌄</view></picker></view>
        <view wx:if="{{!keyboardHeight || pantryFocus === 'custom'}}" class="custom-add-row"><input data-field="custom" bindfocus="onPantryFocus" bindkeyboardheightchange="onKeyboardChange" value="{{customName}}" maxlength="40" disabled="{{busy}}" bindinput="onCustomName" bindconfirm="addCustomIngredient" placeholder="如秋葵" adjust-position="{{false}}"/><button class="secondary" disabled="{{busy || !customName}}" bindtap="addCustomIngredient">选入</button></view>
        <view wx:if="{{!keyboardHeight}}" class="selected-summary"><text class="small">已选 {{addSelected.length}} / 20 种</text><button class="link" disabled="{{busy || !addSelected.length}}" bindtap="clearAddSelected">清空选择</button></view>
        <scroll-view wx:if="{{addSelected.length && !keyboardHeight}}" scroll-x class="selected-ingredients" enhanced show-scrollbar="{{false}}"><button wx:for="{{addSelected}}" wx:key="name" class="selected-ingredient" data-name="{{item.name}}" disabled="{{busy}}" bindtap="toggleAddItem">{{item.name}} ×</button></scroll-view>
        <button class="primary full" disabled="{{busy || !synced || !addSelected.length}}" loading="{{busy}}" bindtap="savePantryAdd">加入冰箱（{{addSelected.length}}）</button>
      </view>
    </view>
  </view>
  <view wx:if="{{editorOpen}}" class="overlay" style="bottom:{{sheetBottom}}px;">
    <view class="sheet-mask" catchtap="closeEditor" catchtouchmove="swallowTap"/>
    <view class="modal {{keyboardHeight ? 'keyboard-sheet' : ''}}" style="height:{{sheetHeight}}px;" catchtap="swallowTap">
      <view class="modal-title"><text>{{draftId ? '编辑菜品' : '新增一道菜'}}</text><button class="link" disabled="{{busy}}" bindtap="closeEditor">关闭</button></view>
      <scroll-view scroll-y class="sheet-scroll" scroll-into-view="{{sheetTarget}}" enhanced show-scrollbar="{{false}}">
        <view class="sheet-content">
          <view id="draft-name-field"><view class="label">菜名</view><input bindkeyboardheightchange="onKeyboardChange" value="{{draftName}}" maxlength="40" data-field="draft-name-field" bindfocus="onSheetFocus" bindinput="onDraftName" placeholder="比如番茄炒蛋" adjust-position="{{false}}" /></view>
          <view class="label">分类</view><view class="row"><button class="role {{draftKind === 'meat' ? 'chosen' : ''}}" data-kind="meat" bindtap="onDraftKind">荤菜</button><button class="role {{draftKind === 'veg' ? 'chosen' : ''}}" data-kind="veg" bindtap="onDraftKind">素菜（含蛋）</button></view>
          <view id="draft-ingredients-field"><view class="label">主要食材</view><textarea bindkeyboardheightchange="onKeyboardChange" value="{{draftIngredients}}" maxlength="800" data-field="draft-ingredients-field" bindfocus="onSheetFocus" bindinput="onDraftIngredients" placeholder="用顿号分开，如番茄、鸡蛋" adjust-position="{{false}}" /></view>
          <text class="note">最多20种主要食材，不填重量和常用调料。仅用于后续搭配。</text>
        </view>
      </scroll-view>
      <view class="sheet-footer"><button class="primary full" loading="{{busy}}" disabled="{{busy}}" bindtap="saveDish">保存菜品</button></view>
    </view>
  </view>
  <view wx:if="{{pickOpen}}" class="overlay" style="bottom:{{sheetBottom}}px;">
    <view class="sheet-mask" catchtap="closePick" catchtouchmove="swallowTap"/>
    <view class="modal {{keyboardHeight ? 'keyboard-sheet' : ''}}" style="height:{{sheetHeight}}px;" catchtap="swallowTap">
      <view class="modal-title"><text>选择另一道{{pickKind === 'meat' ? '荤菜' : '素菜'}}</text><button class="link" disabled="{{busy}}" bindtap="closePick">关闭</button></view>
      <view class="sheet-search"><input bindkeyboardheightchange="onKeyboardChange" value="{{pickSearch}}" bindinput="onPickSearch" placeholder="搜索菜名或食材" adjust-position="{{false}}" /></view>
      <scroll-view scroll-y class="sheet-scroll" enhanced show-scrollbar="{{false}}"><view class="sheet-content"><view wx:if="{{!pickItems.length}}" class="empty">没有符合条件的菜。</view><button wx:for="{{pickItems}}" wx:key="id" class="pick-item" data-id="{{item.id}}" disabled="{{busy}}" bindtap="pickDish"><text>{{item.name}}</text><text class="small">{{item.ingredientsText}}</text></button></view></scroll-view>
    </view>
  </view>
</view>
