/* 手机宽度变化时仍保持可读文字，长菜名和食材不撑出屏幕。 */
page { background:#f7f5ef; color:#28382d; font-family:system-ui,-apple-system,sans-serif; font-size:30rpx; }
view,text,button,input,textarea,scroll-view { box-sizing:border-box; }
text { overflow-wrap:break-word; word-break:break-word; }
button { margin:0; min-height:44px; font-size:28rpx; font-weight:400; line-height:1.5; border-radius:16rpx; white-space:normal; }
/* 微信默认按钮会居中并占固定宽度，这里按实际操作区域指定宽度。 */
.page button.primary,.page button.secondary,.page button.link,.page button.role,
.page button.score,.page button.chip,.page button.nav-button,.page button.pick-item { width:auto; margin:0; }
.page button.full,.page button.pick-item { width:100%; }
button::after { border:0; }
button[disabled] { opacity:.45; }
input,textarea { background:#fafbf5; border:1rpx solid #dce3d2; border-radius:16rpx; padding:20rpx; width:100%; font-size:30rpx; color:#28382d; }
input { height:96rpx; min-height:44px; }
textarea { height:180rpx; min-height:80px; line-height:1.6; }
.page { padding:24rpx 24rpx calc(136rpx + env(safe-area-inset-bottom)); }
.login-page { padding-bottom:calc(32rpx + env(safe-area-inset-bottom)); }
.login { padding-top:12rpx; }
.eyebrow { display:block; color:#708361; font-size:24rpx; margin:20rpx 0 12rpx; }
.headline { display:block; white-space:pre-line; font-size:44rpx; font-weight:600; line-height:1.35; margin:12rpx 0 16rpx; }
.description { display:block; color:#6f786b; font-size:28rpx; line-height:1.65; margin:12rpx 0; }
.card { background:#fffefa; border:1rpx solid #e2e5da; border-radius:24rpx; padding:24rpx; margin:22rpx 0; }
.login-card { margin-top:24rpx; }
.title { font-size:32rpx; font-weight:600; min-width:0; }
.label { font-size:28rpx; color:#64765a; margin:22rpx 0 12rpx; }
.row { display:flex; align-items:center; gap:12rpx; min-width:0; }
.role { flex:1; min-width:0; background:#fafbf5; border:1rpx solid #d9e1d2; padding:20rpx 12rpx; color:#65715e; }
.chosen { background:#e8eee3!important; border-color:#91a67d!important; color:#3c5944!important; }
.primary { background:#3c5944; color:#fff; padding:22rpx 24rpx; }
.secondary { background:transparent; border:1rpx solid #cdd8c5; color:#3c5944; padding:20rpx; }
.full { width:100%; margin:20rpx 0; }
.note { display:block; color:#76816c; font-size:25rpx; line-height:1.65; margin:20rpx 0; }
.error { padding:20rpx; background:#f4e6d6; color:#825b3d; border-radius:16rpx; font-size:27rpx; line-height:1.65; margin:16rpx 0; word-break:break-word; }
.top { display:flex; align-items:center; justify-content:space-between; gap:12rpx; border-bottom:1rpx solid #e2e5da; padding-bottom:10rpx; font-size:30rpx; }
.link { background:transparent; color:#536e47; padding:16rpx 12rpx; font-size:27rpx; flex-shrink:0; }
.sync { font-size:24rpx; color:#708361; margin-top:12rpx; }
.switch-row { display:flex; align-items:center; justify-content:space-between; gap:16rpx; font-size:28rpx; color:#65715e; margin:20rpx 0; }
.switch-row switch { flex-shrink:0; }
.section-title { display:flex; flex-wrap:wrap; justify-content:space-between; align-items:center; gap:12rpx; font-size:31rpx; font-weight:600; margin:28rpx 0 16rpx; }
.small { font-size:25rpx; color:#74816a; font-weight:400; line-height:1.6; }
.empty { padding:36rpx 24rpx; border:1rpx dashed #ccd8c0; border-radius:20rpx; text-align:center; color:#708361; font-size:28rpx; line-height:1.65; margin:20rpx 0; }
.dish-top { display:flex; align-items:flex-start; justify-content:space-between; gap:16rpx; }
.dish-top .title { flex:1; word-break:break-word; }
.kind,.badge { flex-shrink:0; background:#f1eee2; color:#74785f; padding:8rpx 14rpx; border-radius:10rpx; font-size:24rpx; }
.passed { background:#e8eee3; color:#54754c; }
.dish-name { font-size:38rpx; font-weight:600; line-height:1.4; margin:18rpx 0 12rpx; word-break:break-word; }
.availability { display:block; color:#846d48; font-size:26rpx; line-height:1.65; margin:14rpx 0; word-break:break-word; }
.rating-label { display:flex; flex-wrap:wrap; justify-content:space-between; gap:10rpx; color:#64765a; font-size:27rpx; margin:20rpx 0 12rpx; }
/* 六个分数不挤压；小屏改成两行，每个按钮仍有足够点击面积。 */
.scores { display:flex; flex-wrap:wrap; gap:8rpx; }
.score { flex:1; min-width:0; padding:18rpx 0; background:#fafbf5; border:1rpx solid #dce3d2; color:#65715e; font-size:32rpx; }
.score.chosen { background:#3c5944!important; color:#fff!important; }
.card-footer { display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:8rpx; border-top:1rpx solid #e2e5da; padding-top:10rpx; margin-top:20rpx; }
.card-footer .row { margin-left:auto; }
.history-row { padding:18rpx 0; border-bottom:1rpx solid #eceee4; font-size:27rpx; color:#65715e; line-height:1.65; }
.add-bar { display:flex; gap:12rpx; margin:22rpx 0; }
.add-bar input { flex:1; min-width:0; }
.add-bar button { flex-shrink:0; padding-left:22rpx; padding-right:22rpx; }
.chips { display:flex; flex-wrap:wrap; gap:12rpx; }
.chip { padding:16rpx 20rpx; background:#fffefa; border:1rpx solid #dce3d2; color:#65715e; font-size:27rpx; border-radius:14rpx; }
.pantry-chip { display:flex; align-items:center; justify-content:space-between; gap:8rpx; width:calc(50% - 6rpx); min-width:0; border:1rpx solid #e2e5da; background:#fffefa; padding:8rpx 8rpx 8rpx 16rpx; border-radius:16rpx; font-size:28rpx; }
.pantry-chip text { flex:1; min-width:0; word-break:break-word; }
.shopping-row { display:flex; align-items:center; justify-content:space-between; gap:12rpx; padding:16rpx; background:#fffefa; border-bottom:1rpx solid #e2e5da; }
.shopping-row .row { flex:1; }
.shopping-row .row text { flex:1; min-width:0; word-break:break-word; }
.shopping-row switch { flex-shrink:0; }
.strike { text-decoration:line-through; color:#8c9680; }
.filters { display:flex; flex-wrap:wrap; gap:12rpx; }
.menu-actions { flex-wrap:wrap; justify-content:flex-end; gap:8rpx; border-top:1rpx solid #eceee4; padding-top:12rpx; }
.menu-actions .link { background:#f4f6ee; border-radius:12rpx; padding:16rpx; }
.danger { color:#a45e3e; }
/* 底栏留出系统手势区域；输入时隐藏，不与键盘争用屏幕空间。 */
.bottom-nav { position:fixed; bottom:0; left:0; right:0; display:flex; padding:10rpx 12rpx calc(10rpx + env(safe-area-inset-bottom)); background:#fffefa; border-top:1rpx solid #e2e5da; z-index:10; }
.nav-button { flex:1; min-width:0; background:transparent; color:#74816a; font-size:25rpx; padding:16rpx 4rpx; border-radius:12rpx; }
.nav-button.selected { background:#e8eee3; color:#3c5944; font-weight:600; }
/* 弹窗固定在可见区域底部，标题和保存按钮留在外面，只有中间内容滚动。 */
.overlay { position:fixed; top:0; bottom:0; left:0; right:0; background:rgba(37,53,34,.45); display:flex; justify-content:center; align-items:flex-end; z-index:20; }
.sheet-mask { position:absolute; top:0; left:0; right:0; bottom:0; }
.modal { position:relative; display:flex; flex-direction:column; width:100%; max-height:88vh; background:#fffefa; border-radius:28rpx 28rpx 0 0; overflow:hidden; }
.modal-title { display:flex; flex-shrink:0; justify-content:space-between; align-items:center; gap:12rpx; font-size:32rpx; font-weight:600; padding:12rpx 24rpx; border-bottom:1rpx solid #e2e5da; }
.modal-title text { flex:1; min-width:0; }
.sheet-scroll { flex:1; min-height:0; height:0; }
.sheet-content { padding:8rpx 24rpx 24rpx; }
.sheet-footer { flex-shrink:0; padding:16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom)); border-top:1rpx solid #e2e5da; background:#fffefa; }
.sheet-footer .full { margin:0; }
.keyboard-sheet .sheet-footer { padding-bottom:16rpx; }
.sheet-search { flex-shrink:0; padding:18rpx 24rpx; }
.pick-item { width:100%; display:flex; flex-direction:column; gap:10rpx; text-align:left; padding:24rpx 0; background:transparent; border-bottom:1rpx solid #e2e5da; color:#3c5944; line-height:1.6; }
@media (max-width:360px) {
  .scores .score { flex:0 0 calc((100% - 16rpx)/3); }
  .pantry-chip { width:100%; }
  .menu-actions .link { flex:1 1 calc(50% - 8rpx); }
  .nav-button { font-size:24rpx; }
}

/* 冰箱左边固定分类、右边看食材，两边分别滚动，不把所有候选铺成长页面。 */
.fridge-heading { display:flex; justify-content:space-between; align-items:center; gap:16rpx; margin:20rpx 0; }
.fridge-heading > view { min-width:0; flex:1; }
.fridge-heading .headline { font-size:38rpx; margin:0 0 8rpx; }
.fridge-heading button { flex-shrink:0; padding:18rpx; }
.fridge-search,.custom-add-row { display:flex; gap:12rpx; }
.fridge-search input,.custom-add-row input { flex:1; min-width:0; }
.fridge-search button,.custom-add-row button { flex-shrink:0; padding:16rpx 18rpx; }
.fridge-note { margin:14rpx 0; }
.ingredient-browser { display:flex; min-height:0; overflow:hidden; border:1rpx solid #e2e5da; border-radius:18rpx; background:#fffefa; }
.fridge-browser { height:50vh; min-height:240px; }
.category-sidebar { width:164rpx; flex-shrink:0; height:100%; background:#efefe6; }
.page button.category-button { width:100%; margin:0; display:flex; flex-direction:column; justify-content:center; align-items:center; min-height:52px; padding:16rpx 6rpx; background:transparent; border-radius:0; font-size:27rpx; color:#64765a; }
.category-button.active-category { background:#fffefa!important; color:#3c5944; border-left:6rpx solid #3c5944; font-weight:600; }
.category-count { font-size:22rpx; color:#85917b; }
.ingredient-results { height:100%; flex:1; width:0; min-width:0; }
.page button.ingredient-item { display:flex; align-items:center; justify-content:space-between; gap:12rpx; width:100%; margin:0; min-height:52px; padding:22rpx 18rpx; border-radius:0; border-bottom:1rpx solid #eceee4; background:transparent; color:#28382d; text-align:left; }
.ingredient-item[disabled] { opacity:1; }
.ingredient-name { flex:1; min-width:0; word-break:break-word; }
.ingredient-check { flex-shrink:0; font-size:24rpx; color:#64765a; }
.ingredient-empty { color:#708361; padding:30rpx 20rpx; font-size:27rpx; line-height:1.7; }
.fridge-manage-bar { position:fixed; left:0; right:0; bottom:0; z-index:10; background:#fffefa; border-top:1rpx solid #e2e5da; padding:16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom)); display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:8rpx; }
.manage-category { min-height:44px; display:flex; align-items:center; border-radius:16rpx; font-size:27rpx; }
.muted-control { opacity:.45; }
.add-browser { flex:1; height:0; border-radius:0; border-left:0; border-right:0; }
.custom-title,.selected-summary { display:flex; justify-content:space-between; align-items:center; gap:8rpx; }
.custom-title { margin-bottom:12rpx; flex-wrap:wrap; }
.custom-category { min-height:32px; display:flex; align-items:center; font-size:25rpx; color:#3c5944; padding:4rpx 10rpx; background:#e8eee3; border-radius:10rpx; }
.selected-summary .link { min-height:32px; padding:8rpx; font-size:25rpx; }
.selected-ingredients { height:42px; white-space:nowrap; margin-bottom:12rpx; }
.page button.selected-ingredient { display:inline-flex; align-items:center; min-height:36px; width:auto; margin:0 10rpx 0 0; padding:10rpx 14rpx; background:#e8eee3; color:#3c5944; font-size:25rpx; border-radius:12rpx; }
@media (max-width:360px) { .category-sidebar { width:150rpx; } .fridge-heading .headline { font-size:36rpx; } }

/* 自定义输入时收起多余说明，保存按钮和待选按钮在键盘上方仍能操作。 */
.keyboard-sheet .custom-add-row { margin-bottom:12rpx; }

/* 数量选择保留足够的点击范围，小屏下自动换行。 */
.meal-counts { display:flex; flex-wrap:wrap; align-items:center; gap:16rpx; margin:24rpx 0 12rpx; }
.count-choice { min-height:44px; display:flex; align-items:center; padding:16rpx 24rpx; border:1rpx solid #cdd8c5; background:#fffefa; border-radius:16rpx; color:#3c5944; }
/* 食材前面盖住移除按钮，左滑后只露出这一行，右滑恢复。 */
.pantry-swipe-row { position:relative; overflow:hidden; }
.page button.pantry-swipe-front { position:relative; z-index:1; background:#fffefa; transform:translateX(0); transition:transform .18s ease; }
.page button.pantry-swipe-front.swipe-open { transform:translateX(-72px); }
.page button.swipe-remove { position:absolute; right:0; top:0; bottom:0; width:72px; margin:0; border-radius:0; padding:0; background:#a45e3e; color:#fff; display:flex; align-items:center; justify-content:center; }

/* 露出移除时保留食材名称，避免用户看不清自己正在移除哪一项。 */
.pantry-swipe-front.swipe-open .ingredient-name { transform:translateX(72px); margin-right:72px; }

/* 历史先显示一顿的概要，菜品和淘汰详情按需展开，避免手机上一串文字挤在一起。 */
.history-intro { margin:24rpx 0 18rpx; }
.history-intro .small { display:block; margin-top:10rpx; }
.history-search { display:flex; align-items:center; gap:8rpx; margin-bottom:16rpx; }
.history-search input { flex:1; min-width:0; }
.page button.history-card-heading { width:100%; padding:0; margin:0; min-height:52px; display:flex; align-items:flex-start; justify-content:space-between; gap:12rpx; background:transparent; text-align:left; color:#28382d; }
.history-card-summary { min-width:0; flex:1; display:flex; flex-direction:column; gap:8rpx; }
.history-preview { display:block; margin:18rpx 0; line-height:1.7; font-size:29rpx; color:#536e47; }
.history-progress,.history-score { display:flex; flex-wrap:wrap; gap:10rpx 24rpx; justify-content:space-between; color:#74816a; font-size:25rpx; line-height:1.7; }
.history-score { margin-bottom:12rpx; justify-content:flex-start; }
.history-passed { color:#3c5944; font-weight:600; }
.page button.history-detail-toggle { width:100%; text-align:left; padding-left:0; margin:8rpx 0; }
.history-dish { padding:24rpx 0; border-top:1rpx solid #e2e5da; }
.history-repeat { border-top:1rpx solid #e2e5da; padding-top:18rpx; margin-top:16rpx; }
.history-repeat .small { display:block; }
.history-repeat .full { margin-top:14rpx; }
