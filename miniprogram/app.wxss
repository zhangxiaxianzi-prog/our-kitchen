page{background:#f7f5ef;color:#28382d;font-family:system-ui,-apple-system,sans-serif;font-size:28rpx}view,text,button,input,textarea{box-sizing:border-box}button{margin:0;font-size:26rpx;font-weight:400;line-height:1.5;border-radius:14rpx}button::after{border:0}button[disabled]{opacity:.45}input,textarea{background:#fafbf5;border:1rpx solid #dce3d2;border-radius:14rpx;padding:20rpx;width:100%;font-size:26rpx;color:#28382d}input{height:88rpx}textarea{height:190rpx}.page{padding:32rpx 32rpx calc(150rpx + env(safe-area-inset-bottom))}.login{padding-top:45rpx}.eyebrow{display:block;color:#849574;font-size:23rpx;letter-spacing:4rpx;margin:32rpx 0 20rpx}.headline{display:block;white-space:pre-line;font-size:62rpx;line-height:1.5;font-family:serif;margin:14rpx 0 24rpx}.description{display:block;color:#7b8177;font-size:25rpx;line-height:1.9;margin:12rpx 0}.card{background:#fffefa;border:1rpx solid #e2e5da;border-radius:28rpx;padding:32rpx;margin:26rpx 0}.login-card{margin-top:50rpx}.title{font-size:34rpx;font-weight:600}.label{font-size:25rpx;color:#748267;margin:28rpx 0 15rpx}.row{display:flex;align-items:center;gap:16rpx}.role{flex:1;background:#fafbf5;border:1rpx solid #e2e5da;padding:20rpx;color:#7b8177}.chosen{background:#e8eee3!important;border-color:#91a67d!important;color:#3c5944!important}.primary{background:#3c5944;color:#fff;padding:22rpx 24rpx}.secondary{background:transparent;border:1rpx solid #cdd8c5;color:#3c5944;padding:20rpx}.full{width:100%;margin:24rpx 0}.note{display:block;color:#929b86;font-size:22rpx;line-height:1.9;margin:24rpx 0}.error{padding:22rpx;background:#f4e6d6;color:#976d4a;border-radius:14rpx;font-size:25rpx;line-height:1.7;margin:20rpx 0}.top{display:flex;align-items:center;justify-content:space-between;border-bottom:1rpx solid #e2e5da;padding-bottom:20rpx;font-size:30rpx}.link{background:transparent;color:#617753;padding:12rpx;font-size:24rpx;flex-shrink:0}.sync{font-size:21rpx;color:#87977c;margin-top:17rpx}.switch-row{display:flex;align-items:center;justify-content:space-between;font-size:24rpx;color:#7b8177;margin:25rpx 0}.section-title{display:flex;justify-content:space-between;align-items:center;font-size:32rpx;font-weight:600;margin:35rpx 0 20rpx}.small{font-size:22rpx;color:#909884;font-weight:400}.empty{padding:45rpx 28rpx;border:1rpx dashed #ccd8c0;border-radius:24rpx;text-align:center;color:#87977c;font-size:25rpx;line-height:1.9;margin:24rpx 0}.dish-top{display:flex;justify-content:space-between;align-items:center;gap:10rpx}.kind,.badge{background:#f1eee2;color:#8f927c;padding:6rpx 12rpx;border-radius:9rpx;font-size:21rpx}.passed{background:#e8eee3;color:#54754c}.dish-name{font-family:serif;font-size:44rpx;margin:24rpx 0}.availability{display:block;color:#9b835e;font-size:23rpx;line-height:1.8;margin:18rpx 0}.rating-label{display:flex;justify-content:space-between;color:#7c876e;font-size:24rpx;margin:22rpx 0 17rpx}.scores{display:flex;gap:10rpx}.score{flex:1;min-width:0;padding:15rpx 0;background:#fafbf5;border:1rpx solid #e0e5d9;color:#778369}.score.chosen{background:#3c5944!important;color:#fff!important}.card-footer{display:flex;align-items:center;justify-content:space-between;border-top:1rpx solid #e2e5da;padding-top:13rpx;margin-top:23rpx}.history-row{padding:20rpx 0;border-bottom:1rpx solid #eceee4;font-size:24rpx;color:#7b8177;line-height:1.8}.add-bar{display:flex;gap:12rpx;margin:28rpx 0}.add-bar input{flex:1;min-width:0}.add-bar button{flex-shrink:0}.chips{display:flex;flex-wrap:wrap;gap:13rpx}.chip{padding:12rpx 18rpx;background:#fffefa;border:1rpx solid #e2e5da;color:#7a886b;font-size:23rpx;border-radius:12rpx}.pantry-chip{display:flex;align-items:center;justify-content:space-between;border:1rpx solid #e2e5da;background:#fffefa;padding:12rpx 12rpx 12rpx 22rpx;border-radius:16rpx;min-width:calc(50% - 8rpx);font-size:27rpx}.shopping-row{display:flex;align-items:center;justify-content:space-between;padding:22rpx;background:#fffefa;border-bottom:1rpx solid #e2e5da}.shopping-row switch{transform:scale(.8);transform-origin:left center;margin-right:-10rpx}.strike{text-decoration:line-through;color:#a2a990}.filters{display:flex;flex-wrap:wrap;gap:10rpx}.menu-actions{justify-content:flex-end;border-top:1rpx solid #eceee4;padding-top:12rpx}.danger{color:#b07454}.bottom-nav{position:fixed;bottom:0;left:0;right:0;display:flex;padding:18rpx 15rpx calc(18rpx + env(safe-area-inset-bottom));background:#fffefa;border-top:1rpx solid #e2e5da;z-index:10}.nav-button{flex:1;background:transparent;color:#939d87;font-size:24rpx;padding:15rpx 0;border-radius:12rpx}.nav-button.selected{background:#e8eee3;color:#3c5944;font-weight:600}.overlay{position:fixed;inset:0;background:rgba(37,53,34,.45);display:flex;justify-content:center;align-items:center;padding:30rpx;z-index:20}.modal{width:100%;max-height:85vh;overflow-y:auto;background:#fffefa;padding:32rpx;border-radius:27rpx}.modal-title{display:flex;justify-content:space-between;align-items:center;font-size:34rpx;margin-bottom:25rpx}.pick-scroll{height:55vh;margin-top:20rpx}.pick-item{display:flex;flex-direction:column;gap:10rpx;text-align:left;padding:25rpx 5rpx;background:transparent;border-bottom:1rpx solid #e2e5da;color:#3c5944;line-height:1.8}
